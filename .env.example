# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
DB_NAME=mentorlagbe

# URLs (no trailing slash)
CLIENT_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:5000

# Better Auth / JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=http://localhost:5000

# Stripe (dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ImgBB (https://api.imgbb.com/)
IMGBB_API_KEY=replace_me

# Initial admin (only used by `npm run seed`)
ADMIN_NAME=MentorLagbe Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Password used for the documented demo accounts created by the seed
DEMO_PASSWORD=Password123!
