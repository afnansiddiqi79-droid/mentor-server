# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017
DB_NAME=mentorlagbe

# Origins (must match the deployed frontend/API exactly, no trailing slash)
CLIENT_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=http://localhost:5000
JWT_AUDIENCE=http://localhost:5000

# Stripe (use test keys in development; never commit real keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ImgBB uploads
IMGBB_API_KEY=

# Seed script only. ADMIN_PASSWORD is required and must never be committed.
ADMIN_NAME=MentorLagbe Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
DEMO_PASSWORD=replace-with-a-demo-password
